# PostgreSQL (use docker-compose for local)
# Default host port 5435 (change if 5435 is already taken on your machine)
DATABASE_URL=postgresql://grok:grok@127.0.0.1:5435/grok_agent_platform

# Vercel Sandbox (required when backend runs outside Vercel)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Or local: vercel link && vercel env pull → VERCEL_OIDC_TOKEN in .env

XAI_API_KEY=xai-your-key

# Pin global grok npm package in sandbox onCreate (optional)
GROK_VERSION=latest

TEMPLATE_REPO_URL=https://github.com/builder1org/builder-default-g38q8azz.git

PORT=8788
WORKER_POLL_MS=2000
SANDBOX_TIMEOUT_MS=1800000